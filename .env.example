# Cloud SQL MySQL credentials
DB_USER=tsy
DB_PASSWORD=changeme
DB_NAME=treasury

# Preferred for Cloud Run / connector path (project:region:instance)
INSTANCE_CONNECTION_NAME=my-project:us-east1:my-mysql-instance
# PUBLIC (default) | PRIVATE | PSC
DB_IP_TYPE=PUBLIC

# Direct TCP fallback when INSTANCE_CONNECTION_NAME is unset
# (local MySQL, or Cloud SQL public IP + authorized networks)
DB_HOST=127.0.0.1
DB_PORT=3306

# API
PORT=3000
HOST=0.0.0.0

# Ingest
# Number of calendar days to re-upsert on daily sync (default 7)
SYNC_DAYS=7
