# Neon Postgres (pooled connection string recommended for Cloud Run)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# API
PORT=3000
HOST=0.0.0.0

# Shared Bearer token for /v1/* (send as Authorization: Bearer <secret>)
# /health stays unauthenticated for Cloud Run probes
API_SECRET=testpw

# Ingest
# Number of calendar days to re-upsert on daily sync (default 7)
SYNC_DAYS=7
